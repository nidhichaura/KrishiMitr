# --- Twilio credentials (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Optional: a voice/SMS-capable Twilio number for 2G/3G keypad-phone fallback.
TWILIO_VOICE_NUMBER=

# --- App config ---
APP_ENV=development
DEFAULT_LANGUAGE=hi
LOG_LEVEL=INFO
# Keep true whenever the app is reachable from the internet. Set false only
# while manually posting to localhost during development.
VERIFY_TWILIO_SIGNATURES=true
# Your deployed site URL (comma-separated if there is more than one frontend).
CORS_ORIGINS=https://your-domain.example
MAX_IMAGE_UPLOAD_BYTES=8388608
API_RATE_LIMIT_PER_MINUTE=20
# Digits only; powers the website's WhatsApp button.
PUBLIC_WHATSAPP_NUMBER=919876543210

# --- Government of India OGD / AGMARKNET mandi prices ---
# Create an API key at https://data.gov.in, then add it only to .env.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_URL=https://api.data.gov.in/resource

# --- Official live mandi-price source (no API key required) ---
AGMARKNET_API_URL=https://api.agmarknet.gov.in/v1

# --- Real voice input/output (Sarvam AI) ---
SARVAM_API_KEY=
PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.app

# --- Mock external AI services (replace with real endpoints later) ---
BHASHINI_API_URL=https://mock-bhashini.local/api/v1
SARVAM_API_URL=https://mock-sarvam.local/api/v1
